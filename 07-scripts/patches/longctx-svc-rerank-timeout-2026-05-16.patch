 # Generic paraphrase templates — work for code, prose, and config queries.
+def _rerank_predict_subprocess(
+    model: str, query: str, texts: list[str], timeout_seconds: int,
+) -> list[float] | None:
+    """Run CrossEncoder scoring in a killable subprocess.
+
+    The normal sentence-transformers CrossEncoder call is blocking and can
+    take minutes on CPU for large rerankers. Running the scorer in a child
+    process lets the service fall back cleanly when the timeout expires.
+    """
+    if timeout_seconds <= 0 or not texts:
+        return None
+    payload = json.dumps({"model": model, "query": query, "texts": texts})
+    code = r'''
+import json, sys
+from sentence_transformers import CrossEncoder
+payload = json.loads(sys.stdin.read())
+model = payload["model"]
+query = payload["query"]
+texts = payload["texts"]
+reranker = CrossEncoder(model, max_length=512)
+scores = reranker.predict(
+    [(query, t[:2000]) for t in texts],
+    batch_size=16,
+    show_progress_bar=False,
+)
+print(json.dumps([float(x) for x in scores]))
+'''
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", code],
+            input=payload,
+            text=True,
+            capture_output=True,
+            timeout=timeout_seconds,
+            check=True,
+        )
+        data = json.loads(proc.stdout)
+        if isinstance(data, list) and len(data) == len(texts):
+            return [float(x) for x in data]
+    except Exception:
+        return None
+    return None
+
